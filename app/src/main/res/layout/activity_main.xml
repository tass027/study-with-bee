<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9C4"
    android:padding="16dp">

    <!-- Everything except the bee -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_header_bg">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:text="Hello,"
                    android:textColor="#E91E63"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:text="Tasnim Elmehrabi"
                    android:textColor="#D81B60"
                    android:textSize="18sp"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/bee3"
                android:background="@drawable/rounded_image"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:contentDescription="Bee icon" />
        </LinearLayout>

        <!-- Motivational Quote -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buzz your best today! 🐝✨"
            android:textStyle="italic"
            android:textSize="16sp"
            android:textColor="#4E342E"
            android:layout_marginBottom="24dp" />

        <!-- Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLectureNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lecture Notes"
            android:textColor="@android:color/black"
            app:icon="@drawable/ic_book"
            app:iconTint="@android:color/black"
            app:cornerRadius="24dp"
            app:backgroundTint="#FFD54F"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStudyTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Study Timer"
            android:textColor="@android:color/black"
            app:icon="@drawable/ic_timer"
            app:iconTint="@android:color/black"
            app:cornerRadius="24dp"
            app:backgroundTint="#FFD54F"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToDoList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To Do List"
            android:textColor="@android:color/black"
            app:icon="@drawable/ic_todolist"
            app:iconTint="@android:color/black"
            app:cornerRadius="24dp"
            app:backgroundTint="#FFD54F"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAchievements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Achievements / Progress"
            android:textColor="@android:color/black"
            app:icon="@drawable/ic_achievement"
            app:iconTint="@android:color/black"
            app:cornerRadius="24dp"
            app:backgroundTint="#FFD54F"
            android:layout_marginBottom="100dp" />
    </LinearLayout>

    <!-- 🐝 Floating Bee Assistant bottom-right -->
    <LinearLayout
        android:id="@+id/beeAssistant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp">

        <ImageView
            android:id="@+id/beeIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/bee4"
            android:background="@drawable/rounded_image"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:contentDescription="AI StudyBee" />
    </LinearLayout>

</RelativeLayout>
