<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_yellow"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/your_achievements"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/pink_text"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:layout_alignParentTop="true"
            tools:ignore="HardcodedText" />

        <!-- Goals Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvHeader"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 Your Goals"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/pink_text"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp"
                        android:background="@drawable/stat_box_bg"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/tvWeeklyGoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weekly: 0/7 days"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/pink_text"
                            android:gravity="center"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp"
                        android:background="@drawable/stat_box_bg"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/tvDailyGoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daily: 60 min"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/pink_text"
                            android:gravity="center"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp"
                        android:background="@drawable/stat_box_bg">

                        <TextView
                            android:id="@+id/tvCompletedSessions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 sessions"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/pink_text"
                            android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetGoals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Set Goals"
                    android:textColor="@android:color/black"
                    app:backgroundTint="@color/button_yellow"
                    app:cornerRadius="12dp"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Statistics Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardGoals"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvStatsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/your_statistics"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/pink_text"
                    android:layout_marginBottom="16dp"
                    android:layout_alignParentTop="true"
                    tools:ignore="HardcodedText" />

                <!-- First Row: Total Tasks and Completed -->
                <RelativeLayout
                    android:id="@+id/layoutFirstRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvStatsTitle"
                    android:layout_marginBottom="12dp">

                    <RelativeLayout
                        android:id="@+id/layoutTotalTasks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/spacer1"
                        android:padding="8dp"
                        android:background="@drawable/stat_box_bg">

                        <TextView
                            android:id="@+id/tvTotalTasks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/pink_text"
                            android:layout_centerHorizontal="true"
                            android:layout_alignParentTop="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_tasks"
                            android:textSize="12sp"
                            android:textColor="@color/brown_text"
                            android:layout_below="@id/tvTotalTasks"
                            android:layout_centerHorizontal="true" />
                    </RelativeLayout>

                    <View
                        android:id="@+id/spacer1"
                        android:layout_width="12dp"
                        android:layout_height="1dp"
                        android:layout_centerHorizontal="true" />

                    <RelativeLayout
                        android:id="@+id/layoutCompletedTasks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/spacer1"
                        android:layout_alignParentEnd="true"
                        android:padding="8dp"
                        android:background="@drawable/stat_box_bg">

                        <TextView
                            android:id="@+id/tvCompletedTasks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/_0"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/pink_text"
                            android:layout_centerHorizontal="true"
                            android:layout_alignParentTop="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/completed"
                            android:textSize="12sp"
                            android:textColor="@color/brown_text"
                            android:layout_below="@id/tvCompletedTasks"
                            android:layout_centerHorizontal="true" />
                    </RelativeLayout>
                </RelativeLayout>

                <!-- Second Row: Study Time and Streak -->
                <RelativeLayout
                    android:id="@+id/layoutSecondRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/layoutFirstRow">

                    <RelativeLayout
                        android:id="@+id/layoutStudyTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/spacer2"
                        android:padding="8dp"
                        android:background="@drawable/stat_box_bg">

                        <TextView
                            android:id="@+id/tvStudyTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 min"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/pink_text"
                            android:layout_centerHorizontal="true"
                            android:layout_alignParentTop="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Study Time"
                            android:textSize="12sp"
                            android:textColor="@color/brown_text"
                            android:layout_below="@id/tvStudyTime"
                            android:layout_centerHorizontal="true" />
                    </RelativeLayout>

                    <View
                        android:id="@+id/spacer2"
                        android:layout_width="12dp"
                        android:layout_height="1dp"
                        android:layout_centerHorizontal="true" />

                    <RelativeLayout
                        android:id="@+id/layoutStreak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/spacer2"
                        android:layout_alignParentEnd="true"
                        android:padding="8dp"
                        android:background="@drawable/stat_box_bg">

                        <TextView
                            android:id="@+id/tvStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 days"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/pink_text"
                            android:layout_centerHorizontal="true"
                            android:layout_alignParentTop="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Streak 🔥"
                            android:textSize="12sp"
                            android:textColor="@color/brown_text"
                            android:layout_below="@id/tvStreak"
                            android:layout_centerHorizontal="true" />
                    </RelativeLayout>
                </RelativeLayout>

                <!-- Progress Bars Section -->
                <TextView
                    android:id="@+id/tvTaskProgressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Completion Progress (0%)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/brown_text"
                    android:layout_below="@id/layoutSecondRow"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

                <ProgressBar
                    android:id="@+id/progressBarTasks"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/primary_pink"
                    android:layout_below="@id/tvTaskProgressLabel"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvStudyProgressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Study Time Progress (Goal: 300 min - 0%)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/brown_text"
                    android:layout_below="@id/progressBarTasks"
                    android:layout_marginBottom="8dp" />

                <ProgressBar
                    android:id="@+id/progressBarStudy"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/button_yellow"
                    android:layout_below="@id/tvStudyProgressLabel" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- View History Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardStats"
            android:text="📊 View Detailed Statistics"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/primary_pink"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Achievement Badges Title -->
        <TextView
            android:id="@+id/tvBadgesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏅 Badge Collection"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/pink_text"
            android:layout_below="@id/btnViewHistory"
            android:layout_marginBottom="16dp" />

        <!-- First Row of Badges -->
        <RelativeLayout
            android:id="@+id/layoutBadgesRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvBadgesTitle"
            android:layout_marginBottom="12dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardBeginner"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/spacer3"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#CCCCCC">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvBeginnerEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐝"
                        android:textSize="40sp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvBeginnerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Beginner Bee"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_below="@id/tvBeginnerEmoji"
                        android:layout_centerHorizontal="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 tasks or 60 min"
                        android:textSize="10sp"
                        android:textColor="@color/brown_text"
                        android:layout_below="@id/tvBeginnerTitle"
                        android:layout_centerHorizontal="true" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:id="@+id/spacer3"
                android:layout_width="16dp"
                android:layout_height="1dp"
                android:layout_centerHorizontal="true" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardIntermediate"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_toEndOf="@id/spacer3"
                android:layout_alignParentEnd="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#CCCCCC">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvIntermediateEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐝📚"
                        android:textSize="40sp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvIntermediateTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Study Bee"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_below="@id/tvIntermediateEmoji"
                        android:layout_centerHorizontal="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20 tasks or 300 min"
                        android:textSize="10sp"
                        android:textColor="@color/brown_text"
                        android:layout_below="@id/tvIntermediateTitle"
                        android:layout_centerHorizontal="true" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <!-- Second Row of Badges -->
        <RelativeLayout
            android:id="@+id/layoutBadgesRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutBadgesRow1">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardExpert"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/spacer4"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#CCCCCC">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvExpertEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐝🎓"
                        android:textSize="40sp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvExpertTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expert Bee"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_below="@id/tvExpertEmoji"
                        android:layout_centerHorizontal="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50 tasks or 600 min"
                        android:textSize="10sp"
                        android:textColor="@color/brown_text"
                        android:layout_below="@id/tvExpertTitle"
                        android:layout_centerHorizontal="true" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:id="@+id/spacer4"
                android:layout_width="16dp"
                android:layout_height="1dp"
                android:layout_centerHorizontal="true" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardMaster"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_toEndOf="@id/spacer4"
                android:layout_alignParentEnd="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#CCCCCC">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvMasterEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐝👑"
                        android:textSize="40sp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvMasterTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Master Bee"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_below="@id/tvMasterEmoji"
                        android:layout_centerHorizontal="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100 tasks or 1200 min"
                        android:textSize="10sp"
                        android:textColor="@color/brown_text"
                        android:layout_below="@id/tvMasterTitle"
                        android:layout_centerHorizontal="true" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

    </RelativeLayout>
</ScrollView>