<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout principal de l'activité LectureNotesActivity.
    Design harmonisé avec le style de l'application principale
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9C4"
    android:padding="16dp">

    <!-- Contenu défilable -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Section avec icône -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_header_bg">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="Lecture Notes"
                        android:textColor="#E91E63"
                        android:textStyle="bold"
                        android:textSize="24sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="Record and Review 📚"
                        android:textColor="#D81B60"
                        android:textSize="16sp"
                        android:layout_marginTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/bee3"
                    android:background="@drawable/rounded_image"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:contentDescription="Bee icon" />
            </LinearLayout>

            <!-- Citation motivante -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buzz through your learning! 🎧✨"
                android:textStyle="italic"
                android:textSize="15sp"
                android:textColor="#4E342E"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp" />

            <!-- 🎵 Section Audio -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Titre de la section audio -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎵 Lecture Audio"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#E91E63"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <!-- Boutons de sélection et enregistrement audio -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:gravity="center"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_select_audio"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Select Audio"
                            android:textColor="@android:color/black"
                            app:icon="@drawable/ic_book"
                            app:iconTint="@android:color/black"
                            app:cornerRadius="20dp"
                            app:backgroundTint="#FFD54F"
                            android:layout_marginEnd="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_record"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Record"
                            android:textColor="@android:color/black"
                            app:icon="@drawable/ic_timer"
                            app:iconTint="@android:color/black"
                            app:cornerRadius="20dp"
                            app:backgroundTint="#FFD54F" />
                    </LinearLayout>

                    <!-- Boutons Play / Pause / Stop -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_play"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Play"
                            android:textColor="@android:color/black"
                            app:cornerRadius="20dp"
                            app:backgroundTint="#FFD54F"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pause"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pause"
                            android:textColor="@android:color/black"
                            app:cornerRadius="20dp"
                            app:backgroundTint="#FFD54F"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_stop"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Stop"
                            android:textColor="@android:color/white"
                            app:cornerRadius="20dp"
                            app:backgroundTint="#E91E63" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 📝 Section Notes -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Titre -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📝 Study Notes"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#E91E63"
                        android:gravity="center"
                        android:layout_marginBottom="12dp" />

                    <!-- Zone de texte pour les notes -->
                    <EditText
                        android:id="@+id/et_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_bg"
                        android:gravity="top"
                        android:hint="Type your lecture notes here... ✍️"
                        android:inputType="textMultiLine"
                        android:minHeight="180dp"
                        android:textColor="@color/black"
                        android:textColorHint="#9E9E9E"
                        android:textSize="15sp"
                        android:padding="16dp" />

                    <!-- Avertissement sur la sauvegarde automatique -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💾 Notes are automatically saved when you leave this screen"
                        android:textSize="13sp"
                        android:textColor="#4E342E"
                        android:gravity="center"
                        android:textStyle="italic"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 🐝 Floating Bee Assistant bottom-right -->
    <LinearLayout
        android:id="@+id/beeAssistant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp">


    </LinearLayout>

</RelativeLayout>