<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFEF8"
    app:strokeWidth="1dp"
    app:strokeColor="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="14dp"
            android:layout_gravity="top">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/checkbox_circle_bg" />

            <CheckBox
                android:id="@+id/cbTask"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:button="@drawable/custom_checkbox"
                android:background="@android:color/transparent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPriorityEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvTaskTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sample Task Title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#3D2E1F"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTaskDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task description goes here..."
                android:textSize="13sp"
                android:textColor="#6B5641"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvPriority"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Low"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/priority_badge"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvDueDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📅 Due: 12/01/2025"
                    android:textSize="12sp"
                    android:textColor="#8B7355"
                    android:layout_marginStart="10dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:id="@+id/selectionIndicator"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#FFB347"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>